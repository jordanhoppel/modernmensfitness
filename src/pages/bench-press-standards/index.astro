<script>
document.querySelectorAll<HTMLButtonElement>('.u-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    document.body.dataset.unit = btn.dataset.unit;
    document.querySelectorAll('.u-btn').forEach((b) => b.classList.toggle('active', b === btn));
