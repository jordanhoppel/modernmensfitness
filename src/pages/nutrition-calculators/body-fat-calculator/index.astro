---
import NutritionCalcPage from '../../../layouts/NutritionCalcPage.astro';
import { BODY_FAT_CATEGORIES, navyBodyFat } from '../../../lib/nutrition';

const calcSchema = (name: string, url: string, desc: string) => ({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": name,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Web",
  "url": url,
  "description": desc,
  "author": { "@id": "https://modernmensfitness.com/#jordan-hoppel" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
});
const faqSchemaOf = (faq: { q: string; a: string }[]) => ({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
});

const url = 'https://modernmensfitness.com/nutrition-calculators/body-fat-calculator/';
const exM = navyBodyFat('M', 72, 16, 34)!.toFixed(1);
const faq = [
  { q: 'How accurate is the US Navy body fat method?', a: 'Published comparisons put its typical error at about 3 to 4 percentage points against a DEXA scan, and it can be further off for an individual. It tends to be consistent for the same person measured the same way, which makes it better for tracking change than for pinning down an exact number.' },
  { q: 'How do I measure myself correctly?', a: 'Use a flexible tape measure on bare skin and keep it level and snug without squeezing. Measure the neck just below the larynx. Men measure the waist at the navel. Women measure the waist at its narrowest point and the hips at their widest point. Take each measurement three times and use the average.' },
  { q: 'What is a good body fat percentage?', a: 'The American Council on Exercise lists essential fat at 2 to 5 percent for men and 10 to 13 percent for women, athletes at 6 to 13 and 14 to 20, fitness at 14 to 17 and 21 to 24, and average at 18 to 24 and 25 to 31. These are descriptive ranges, not medical diagnoses.' },
  { q: 'Why is my result different from a DEXA scan or a smart scale?', a: 'Every method makes different assumptions. Tape measurements estimate fat from body shape, smart scales estimate it from electrical resistance, and DEXA images tissue directly. Pick one method and use it consistently, because the change over time is more useful than any single reading.' },
  { q: 'How often should I measure?', a: 'Every two to four weeks is plenty. Body fat changes slowly, and measuring more often mostly adds noise from water and small tape differences.' },
];
---

<NutritionCalcPage
  title="Body Fat Calculator: US Navy Method (Tape Measure)"
  description="Free body fat calculator using the US Navy tape measure method. Enter your height, neck, waist and hip to estimate your body fat percentage and see where it falls."
  canonical={url}
  schema={[calcSchema('Body Fat Calculator', url, 'Free body fat calculator using the US Navy circumference method.'), faqSchemaOf(faq)]}
  crumb="Body Fat Calculator"
  h1a="Body Fat"
  h1b="Calculator."
  sub="Estimate your body fat percentage from a tape measure, using the same method the US Navy has used since the 1980s."
>
  <div class="calc-card">
    <div class="calc-header"><span class="input-label">// Your measurements</span></div>
    <div class="calc-inputs">
      <div class="input-group">
        <label class="input-label">Units</label>
        <div class="seg" id="units-seg">
          <button type="button" class="seg-btn active" data-units="imperial">Inches, pounds</button>
          <button type="button" class="seg-btn" data-units="metric">Centimetres, kg</button>
        </div>
      </div>
      <div class="input-group">
        <label class="input-label">Sex (the formula differs)</label>
        <div class="seg" id="sex-seg">
          <button type="button" class="seg-btn active" data-sex="M">Male</button>
          <button type="button" class="seg-btn" data-sex="F">Female</button>
        </div>
      </div>
      <div class="two-col">
        <div class="input-group"><label class="input-label" for="height" data-len>Height (in)</label><input type="number" id="height" class="calc-input" placeholder="70" min="1" step="any" inputmode="decimal" /></div>
        <div class="input-group"><label class="input-label" for="neck" data-len>Neck (in)</label><input type="number" id="neck" class="calc-input" placeholder="15.5" min="1" step="any" inputmode="decimal" /></div>
        <div class="input-group"><label class="input-label" for="waist" data-len>Waist (in)</label><input type="number" id="waist" class="calc-input" placeholder="34" min="1" step="any" inputmode="decimal" /></div>
        <div class="input-group" id="hip-group" hidden><label class="input-label" for="hip" data-len>Hip (in)</label><input type="number" id="hip" class="calc-input" placeholder="38" min="1" step="any" inputmode="decimal" /></div>
      </div>
      <div class="input-group">
        <label class="input-label" for="bw" id="bw-label">Body weight (lb, optional)</label>
        <input type="number" id="bw" class="calc-input" placeholder="Adds fat mass and lean mass to the result" min="1" step="any" inputmode="decimal" />
      </div>
    </div>
    <p class="calc-error" id="calc-error" role="alert" hidden></p>
    <button type="button" class="calc-btn" id="calculate-btn">Calculate My Body Fat →</button>

    <div class="calc-results" id="calc-results" hidden>
      <div class="result-grid">
        <div class="result-main"><span class="result-tag">// Estimated body fat</span><div class="result-num" id="out-bf">--</div><span class="result-unit" id="out-cat"></span></div>
        <div class="result-main" id="mass-card" hidden><span class="result-tag">// Fat mass / lean mass</span><div class="result-num" id="out-mass" style="font-size:2rem;">--</div><span class="result-unit">of your body weight</span></div>
      </div>
      <p class="result-note">This is an estimate that is typically within 3 to 4 percentage points of a DEXA scan, and can be further off for you. Use it to track change over time, measuring the same way each time.</p>
    </div>
  </div>

  <div class="prose" style="margin-top:48px;">
    <h2>How the US Navy Body Fat Method Works</h2>
    <p>The method comes from Hodgdon and Beckett at the Naval Health Research Center (1984) and estimates body fat from circumference measurements, because the neck, waist and hip change with fat in a predictable way. With measurements in inches:</p>
    <ul>
      <li><strong>Men:</strong> body fat % = 86.010 x log10(waist - neck) - 70.041 x log10(height) + 36.76</li>
      <li><strong>Women:</strong> body fat % = 163.205 x log10(waist + hip - neck) - 97.684 x log10(height) - 78.387</li>
    </ul>
    <p>For example, a man who is 72 inches tall with a 16 inch neck and a 34 inch waist comes out at {exM} percent.</p>

    <h2>How to Take the Measurements</h2>
    <ul>
      <li><strong>Neck:</strong> just below the larynx (Adam's apple), tape sloping slightly down toward the front.</li>
      <li><strong>Waist, men:</strong> at the navel, relaxed and not pulled in.</li>
      <li><strong>Waist, women:</strong> at the narrowest point of the waist.</li>
      <li><strong>Hip, women:</strong> at the widest point of the hips and buttocks.</li>
      <li>Keep the tape level and snug without compressing the skin. Measure three times and average.</li>
    </ul>

    <h2>Body Fat Percentage Categories</h2>
    <div class="chart-wrap">
      <table class="pct-table data-table">
        <thead><tr><th>Category</th><th>Men</th><th>Women</th></tr></thead>
        <tbody>
          {BODY_FAT_CATEGORIES.M.map((m, i) => {
            const w = BODY_FAT_CATEGORIES.F[i];
            const range = (c: { from: number; to: number }) => (c.to >= 100 ? `${c.from}% and above` : `${c.from} to ${c.to - 1}%`);
            return (<tr><td>{m.label}</td><td>{range(m)}</td><td>{range(w)}</td></tr>);
          })}
        </tbody>
      </table>
    </div>
    <p class="chart-note">Categories as published by the American Council on Exercise. They describe where a number falls, and they are not medical diagnoses.</p>

    <h2>How Accurate Is It?</h2>
    <p>Studies that compare the Navy method with DEXA typically report an error of about 3 to 4 percentage points, and the direction of the error is not the same in every study. That is good enough to follow a trend and not good enough to chase a precise number. If you want one number you can trust, get a DEXA scan, and if you want to see progress, measure the same way every few weeks.</p>

    <h2>Frequently Asked Questions</h2>
    {faq.map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    <p class="chart-note" style="margin-top:20px;">Sources: Hodgdon JA, Beckett MB, Naval Health Research Center reports (1984). American Council on Exercise body fat categories.</p>
  </div>
</NutritionCalcPage>

<script>
import { navyBodyFat, bodyFatCategory, LB_PER_KG, CM_PER_IN, type Sex } from '../../../lib/nutrition';

const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
const out = (id: string) => document.getElementById(id)!;
let units: 'imperial' | 'metric' = 'imperial';
let sex: Sex = 'M';

function setLabels() {
  const len = units === 'metric' ? 'cm' : 'in';
  document.querySelectorAll<HTMLElement>('[data-len]').forEach((l) => { l.textContent = l.textContent!.replace(/\((in|cm)\)/, `(${len})`); });
  out('bw-label').textContent = `Body weight (${units === 'metric' ? 'kg' : 'lb'}, optional)`;
}

function run(clicked: boolean) {
  const h = parseFloat($('height').value), neck = parseFloat($('neck').value), waist = parseFloat($('waist').value), hip = parseFloat($('hip').value);
  const errEl = out('calc-error');
  const need = sex === 'F' ? [h, neck, waist, hip] : [h, neck, waist];
  if (need.some((v) => !(v > 0))) { errEl.textContent = clicked ? (sex === 'F' ? 'Enter your height, neck, waist and hip.' : 'Enter your height, neck and waist.') : ''; errEl.hidden = !errEl.textContent; return; }
  const toIn = (v: number) => (units === 'metric' ? v / CM_PER_IN : v);
  const bf = navyBodyFat(sex, toIn(h), toIn(neck), toIn(waist), sex === 'F' ? toIn(hip) : 0);
  if (bf === null || !Number.isFinite(bf)) { errEl.textContent = 'Your waist must be larger than your neck. Check the measurements.'; errEl.hidden = false; out('calc-results').hidden = true; return; }
  if (bf < 2 || bf > 60) { errEl.textContent = `That works out to ${Math.round(bf * 10) / 10}%, which is outside the range this method handles. Check the measurements and units.`; errEl.hidden = false; out('calc-results').hidden = true; return; }
  errEl.hidden = true;
  out('out-bf').textContent = `${(Math.round(bf * 10) / 10).toFixed(1)}%`;
  out('out-cat').textContent = bodyFatCategory(sex, bf);
  const w = parseFloat($('bw').value);
  const card = out('mass-card');
  if (w > 0) {
    const unit = units === 'metric' ? 'kg' : 'lb';
    out('out-mass').textContent = `${(w * bf / 100).toFixed(1)} ${unit} / ${(w * (1 - bf / 100)).toFixed(1)} ${unit}`;
    card.hidden = false;
  } else card.hidden = true;
  out('calc-results').hidden = false;
  if (clicked) out('calc-results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

document.querySelectorAll<HTMLButtonElement>('#units-seg .seg-btn').forEach((b) => b.addEventListener('click', () => {
  document.querySelectorAll('#units-seg .seg-btn').forEach((x) => x.classList.toggle('active', x === b));
  const next = b.dataset.units as typeof units;
  if (next !== units) {
    const f = next === 'metric' ? CM_PER_IN : 1 / CM_PER_IN;
    ['height', 'neck', 'waist', 'hip'].forEach((id) => { const v = parseFloat($(id).value); if (v > 0) $(id).value = String(Math.round(v * f * 10) / 10); });
    const w = parseFloat($('bw').value); if (w > 0) $('bw').value = String(Math.round((next === 'metric' ? w / LB_PER_KG : w * LB_PER_KG) * 10) / 10);
  }
  units = next; setLabels(); run(false);
}));
document.querySelectorAll<HTMLButtonElement>('#sex-seg .seg-btn').forEach((b) => b.addEventListener('click', () => {
  document.querySelectorAll('#sex-seg .seg-btn').forEach((x) => x.classList.toggle('active', x === b));
  sex = b.dataset.sex as Sex; out('hip-group').hidden = sex === 'M'; run(false);
}));
['height', 'neck', 'waist', 'hip', 'bw'].forEach((id) => $(id).addEventListener('input', () => run(false)));
out('calculate-btn').addEventListener('click', () => run(true));
</script>
