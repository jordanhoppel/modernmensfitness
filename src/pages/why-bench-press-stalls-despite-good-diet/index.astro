---
import ArticlePage from '../../layouts/ArticlePage.astro';

const LB_PER_KG = 2.20462262;
const bwLb = 180;
const bwKg = bwLb / LB_PER_KG;
const g = (perKg: number) => Math.round(bwKg * perKg);
const issnLow = g(1.4), issnHigh = g(2.0), morton = g(1.62), jordan = bwLb;

const faq = [
  { q: 'How much protein do I need to keep my bench going up?', a: `Jordan\'s easy rule is one gram of protein per pound of body weight. Research gives a lower range: the International Society of Sports Nutrition says 1.4 to 2.0 grams per kilogram per day is enough for most exercising people, and a meta-analysis found no extra muscle gain from protein beyond about 1.6 grams per kilogram. For a ${bwLb} lb person that is about ${issnLow} to ${issnHigh} grams a day on the research range and ${jordan} grams on Jordan\'s rule.` },
  { q: 'Does it matter when I eat protein?', a: 'Total daily protein matters most. Jordan says the post-workout window does not matter. The ISSN position stand says the best timing is likely a matter of individual tolerance, since benefits come from before or after training, and that the effect of a workout lasts at least 24 hours. It suggests spreading protein across the day, roughly every 3 to 4 hours.' },
  { q: 'Is creatine safe?', a: 'The ISSN position stand concludes that short- and long-term creatine supplementation, with studies of up to 30 grams a day for 5 years, is safe and well tolerated in healthy people. Jordan says to get health advice from your doctor, ideally someone who measures the levels in your body, and to handle the basics before supplements.' },
  { q: 'Do I have to eat in a surplus to get stronger?', a: 'Jordan\'s starting point for gaining muscle is to estimate your maintenance calories and add 300 to 500. If you are eating at or below maintenance and your bench is stuck, it is one of the first things to check. Use the TDEE calculator to find your number.' },
];
---

<ArticlePage
  title="Bench Press Stalled Even Though You Eat Well? What to Check"
  description="If your bench press has stalled and your diet looks fine, here is what to check: protein, calories, sleep and creatine, with what the research says and Jordan Hoppel's own rules."
  canonical="https://modernmensfitness.com/why-bench-press-stalls-despite-good-diet/"
  heading="Bench Press Stalled Even Though You Eat Well? What to Check"
  eyebrow="Plateau Fix"
  updated="2026-11-10"
  shortAnswer="Check four things before blaming your program: protein, calories, sleep and, if you are interested, creatine. Jordan's rules are one gram of protein per pound of body weight, maintenance calories plus 300 to 500 to gain, as much sleep as you can get, and creatine if you want it. The research is a little lower on protein (1.4 to 2.0 grams per kilogram, with no extra muscle gain past about 1.6) and well supports creatine's safety. If all four are fine, the cause is probably training, so look at technique, recovery and programming."
  sources={[{ text: 'Morton RW, Murphy KT, McKellar SR, et al. A systematic review, meta-analysis and meta-regression of the effect of protein supplementation on resistance training-induced gains in muscle mass and strength in healthy adults. Br J Sports Med. 2018;52(6):376-384.', doi: '10.1136/bjsports-2017-097608' }, { text: 'Jager R, Kerksick CM, Campbell BI, et al. International Society of Sports Nutrition position stand: protein and exercise. J Int Soc Sports Nutr. 2017;14:20.', doi: '10.1186/s12970-017-0177-8' }, { text: 'Kreider RB, Kalman DS, Antonio J, et al. International Society of Sports Nutrition position stand: safety and efficacy of creatine supplementation in exercise, sport, and medicine. J Int Soc Sports Nutr. 2017;14:18.', doi: '10.1186/s12970-017-0173-z' }]}
  faq={faq}
  related={[
    { href: '/nutrition-calculators/protein-calculator/', label: 'Protein calculator' },
    { href: '/nutrition-calculators/tdee-calculator/', label: 'TDEE calculator' },
