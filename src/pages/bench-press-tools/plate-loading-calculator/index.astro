---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Bench Press Plate Loading Calculator",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Web",
  "url": "https://modernmensfitness.com/bench-press-tools/plate-loading-calculator/",
  "description": "Free barbell plate loading calculator. Enter any target weight and instantly see which plates to load on each side. Works with lbs and kg.",
  "author": { "@id": "https://modernmensfitness.com/#jordan-hoppel" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<BaseLayout
  title="Barbell Plate Calculator: What Plates to Load (lbs and kg)"
  description="Free barbell plate calculator. Enter your target bench press weight and instantly see exactly which plates go on each side. Works with lbs and kg."
  canonical="https://modernmensfitness.com/bench-press-tools/plate-loading-calculator/"
  schema={schema}
>

  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a> <span>›</span>
        <a href="/bench-press-tools/">Tools</a> <span>›</span>
        <span>Plate Calculator</span>
      </nav>
      <span class="eyebrow">Free Tool</span>
      <h1>Plate Loading<br/><em>Calculator.</em></h1>
      <p class="page-sub">Stop doing bar math in your head. Enter your target weight and see exactly which plates go on each side, every time.</p>
    </div>
  </section>

  <section class="section">
    <div class="container calc-layout">
      <div class="calc-main">
        <div class="calc-card">
          <div class="calc-header">
            <span class="mono" style="font-size:0.65rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--muted2);">// Enter target weight</span>
          </div>
          <div class="calc-inputs">
            <div class="input-group">
              <label class="input-label mono">Bar Weight</label>
              <div class="bar-select">
                <button class="bar-btn active" data-bar="45">45 lb bar</button>
                <button class="bar-btn" data-bar="35">35 lb bar</button>
                <button class="bar-btn" data-bar="20">20 kg bar</button>
                <button class="bar-btn" data-bar="15">15 kg bar</button>
              </div>
            </div>
            <div class="input-group">
              <label class="input-label mono">Target Weight</label>
              <div class="input-row">
                <input type="number" id="target-weight" placeholder="225" min="1" max="1500" class="calc-input" />
                <div class="unit-toggle">
                  <button class="unit-btn active" data-unit="lbs">lbs</button>
                  <button class="unit-btn" data-unit="kg">kg</button>
                </div>
              </div>
            </div>
          </div>
          <div class="calc-inputs" style="padding-top:0;">
            <div class="input-group">
              <label class="input-label mono">Plates your gym has (tap to turn off)</label>
              <div class="plate-chips" id="plate-chips"></div>
            </div>
          </div>
          <p class="calc-error" id="calc-error" role="alert" hidden></p>
          <button class="calc-btn" id="calc-btn">Calculate Plates →</button>

          <div class="calc-results" id="calc-results" style="display:none;">
            <div class="result-header">
              <span class="mono" style="font-size:0.65rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--lime);">// Each side of the bar</span>
            </div>
            <div class="plates-display" id="plates-display"></div>
            <div class="weight-breakdown" id="weight-breakdown"></div>
            <div class="common-weights">
              <span class="mono" style="font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted2);display:block;margin-bottom:10px;">// Quick reference</span>
              <div class="quick-grid" id="quick-grid"></div>
            </div>
          </div>
        </div>

        <div class="prose" style="margin-top:48px;">
          <h2>How to Use the Plate Calculator</h2>
          <p>Enter your target total weight including the bar. The calculator shows exactly which plates go on each side. Standard Olympic barbell weighs 45 lbs (20 kg). Women's barbells weigh 35 lbs (15 kg).</p>

          <h2>Common Bench Press Plate Combinations</h2>
          <p><strong>135 lbs</strong>: One 45-lb plate each side (1 plate)<br/>
          <strong>185 lbs</strong>: 45 + 25 each side<br/>
          <strong>225 lbs</strong>: Two 45-lb plates each side (2 plates)<br/>
          <strong>275 lbs</strong>: 45 + 45 + 25 each side<br/>
          <strong>315 lbs</strong>: Three 45-lb plates each side (3 plates)<br/>
          <strong>365 lbs</strong>: 45 + 45 + 45 + 25 each side<br/>
          <strong>405 lbs</strong>: Four 45-lb plates each side (4 plates)</p>

          <h2>Why "How Many Plates" Matters</h2>
          <p>Bench press milestones are typically measured in plates: one plate (135 lbs), two plates (225 lbs), three plates (315 lbs). These are the strength benchmarks most lifters use to gauge progress. The Primal Press Protocol is built to take intermediate lifters from wherever they are to the next plate milestone.</p>
        </div>
      </div>

      <aside class="calc-sidebar">
        <div class="sidebar-sticky">
          <div class="sidebar-ppp">
            <span class="eyebrow">The Program</span>
            <h4>Auto-Calculate Every Set</h4>
            <p>The Primal Press Protocol calculates your plate loading for every set in the 12-week program automatically.</p>
            <a href="https://primalpressprotocol.com?utm_source=mmf&utm_medium=plate-calc&utm_campaign=sidebar" class="btn-primary" target="_blank" rel="noopener" style="width:100%;justify-content:center;">Get PPP for $37 →</a>
          </div>
          <div class="sidebar-widget">
            <h5>More Tools</h5>
            <a href="/bench-press-tools/1rm-calculator/" class="sidebar-link"><span>1RM Calculator</span><span>→</span></a>
            <a href="/bench-press-tools/rpe-calculator/" class="sidebar-link"><span>RPE Calculator</span><span>→</span></a>
            <a href="/bench-press-tools/dots-calculator/" class="sidebar-link"><span>DOTS Calculator</span><span>→</span></a>
            <a href="/bench-press-tools/training-max-calculator/" class="sidebar-link"><span>Training Max Calculator</span><span>→</span></a>
            <a href="/bench-press-tools/assessment-test/" class="sidebar-link"><span>Strength Assessment</span><span>→</span></a>
          </div>
        </div>
      </aside>
    </div>
  </section>

</BaseLayout>

<style>
.page-hero { background: var(--surface); border-bottom: 1px solid var(--border); padding: 48px 0 40px; }
.breadcrumb { display: flex; gap: 8px; align-items: center; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted2); margin-bottom: 24px; flex-wrap: wrap; }
.breadcrumb a { color: var(--muted2); text-decoration: none; }
.breadcrumb a:hover { color: var(--text); }
.page-hero h1 { margin: 16px 0 16px; }
.page-sub { font-size: 1rem; color: var(--muted); max-width: 500px; font-weight: 300; }
.calc-layout { display: grid; grid-template-columns: 1fr 300px; gap: 60px; align-items: start; }
.calc-card { background: var(--surface); border: 1px solid var(--border); border-top: 2px solid var(--lime); overflow: hidden; }
.calc-header { padding: 16px 24px; border-bottom: 1px solid var(--border); background: var(--lime-glow); }
.calc-inputs { padding: 28px 24px 0; display: flex; flex-direction: column; gap: 24px; }
.input-group { display: flex; flex-direction: column; gap: 10px; }
.input-label { font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted2); }
.bar-select { display: flex; gap: 4px; flex-wrap: wrap; }
.bar-btn { background: var(--card); border: 1px solid var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.06em; padding: 8px 14px; cursor: pointer; transition: all 0.2s; }
.bar-btn.active { background: var(--lime); color: #0a0a0a; border-color: var(--lime); }
.input-row { display: flex; gap: 8px; align-items: center; }
.calc-input { flex: 1; background: var(--card); border: 1px solid var(--border); color: var(--text); font-family: var(--font-body); font-size: 1.1rem; font-weight: 500; padding: 12px 16px; outline: none; transition: border-color 0.2s; }
.calc-input:focus { border-color: var(--lime); }
.calc-input::placeholder { color: var(--muted2); }
.unit-toggle { display: flex; gap: 2px; }
.unit-btn { background: var(--card); border: 1px solid var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; padding: 8px 14px; cursor: pointer; transition: all 0.2s; }
.unit-btn.active { background: var(--lime); color: #0a0a0a; border-color: var(--lime); }
.calc-btn { display: block; width: calc(100% - 48px); margin: 24px 24px; background: var(--lime); color: #0a0a0a; font-family: var(--font-body); font-size: 1rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 16px; border: none; cursor: pointer; transition: background 0.2s, transform 0.15s; }
.calc-btn:hover { background: #ccff00; transform: translateY(-1px); }
.calc-results { padding: 0 24px 28px; }
.result-header { margin-bottom: 16px; }
.plates-display { background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--lime); padding: 20px 24px; margin-bottom: 12px; font-family: var(--font-display); font-size: 1.5rem; color: var(--text); line-height: 1.4; letter-spacing: 0.02em; }
.weight-breakdown { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted2); margin-bottom: 24px; letter-spacing: 0.06em; }
.quick-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px; }
.quick-item { background: var(--card); border: 1px solid var(--border); padding: 10px 12px; cursor: pointer; transition: border-color 0.2s; }
.quick-item:hover { border-color: var(--lime); }
.quick-item .q-weight { font-family: var(--font-display); font-size: 1.1rem; color: var(--text); }
.quick-item .q-plates { font-family: var(--font-mono); font-size: 0.6rem; color: var(--muted2); }
.sidebar-sticky { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 12px; }
.sidebar-ppp { background: var(--surface); border: 1px solid var(--border); border-top: 2px solid var(--lime); padding: 24px 20px; }
.sidebar-ppp h4 { font-family: var(--font-display); font-size: 1.4rem; letter-spacing: 0.02em; margin: 8px 0 10px; }
.sidebar-ppp p { font-size: 0.825rem; font-weight: 300; margin-bottom: 16px; }
.sidebar-widget { background: var(--surface); border: 1px solid var(--border); padding: 16px 20px; }
.sidebar-widget h5 { color: var(--muted2); margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
.sidebar-link { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 0.825rem; color: var(--muted); text-decoration: none; transition: color 0.2s; }
.sidebar-link:last-child { border-bottom: none; }
.sidebar-link:hover { color: var(--text); }
@media (max-width: 900px) { .calc-layout { grid-template-columns: 1fr; } .calc-sidebar { display: none; } }
.calc-main { min-width: 0; }
.plate-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { background: var(--card); border: 1px solid var(--border); color: var(--muted2); font-family: var(--font-mono); font-size: 0.75rem; padding: 8px 12px; cursor: pointer; text-decoration: line-through; transition: all 0.2s; }
.chip.on { background: var(--lime); color: #0a0a0a; border-color: var(--lime); text-decoration: none; }
.calc-error { margin: 16px 24px 0; padding: 10px 14px; border-left: 3px solid #ff5a4f; background: var(--card); color: var(--text); font-size: 0.85rem; }
.calc-error[hidden] { display: none; }
.quick-item { cursor: pointer; }
</style>

<script>
type Unit = 'lbs' | 'kg';

const PLATE_SETS: Record<Unit, number[]> = {
  lbs: [45, 35, 25, 10, 5, 2.5],
  kg: [25, 20, 15, 10, 5, 2.5, 1.25],
};
const DEFAULT_BAR: Record<Unit, number> = { lbs: 45, kg: 20 };
const QUICK: Record<Unit, number[]> = {
  lbs: [95, 115, 135, 155, 185, 205, 225, 245, 275, 295, 315, 335],
  kg: [40, 50, 60, 70, 80, 90, 100, 110, 120, 130, 140, 150],
};

let unit: Unit = 'lbs';
let barWeight = 45;
let enabled: Record<Unit, Set<number>> = { lbs: new Set(PLATE_SETS.lbs), kg: new Set(PLATE_SETS.kg) };

const targetEl = document.getElementById('target-weight') as HTMLInputElement;
const errorEl = document.getElementById('calc-error') as HTMLElement;
const chipsEl = document.getElementById('plate-chips') as HTMLElement;

const showError = (msg: string) => { errorEl.textContent = msg; errorEl.hidden = !msg; };
const activePlates = () => PLATE_SETS[unit].filter((p) => enabled[unit].has(p)); // already largest first

/** Fewest plates per side that add up exactly, preferring bigger plates on ties. Works in quarter units to avoid float drift. */
function fitPlates(perSide: number, plates: number[]) {
  const Q = 4;
  const goal = Math.round(perSide * Q);
  if (Math.abs(perSide * Q - goal) > 1e-6 || goal < 0) return null;
  const sizes = plates.map((p) => Math.round(p * Q));
  const limit = goal + 8 * Q;
  const best: number[] = new Array(limit + 1).fill(Infinity);
  const pick: number[] = new Array(limit + 1).fill(-1);
  best[0] = 0;
  for (let t = 1; t <= limit; t++) {
    for (let i = 0; i < sizes.length; i++) {
      const left = t - sizes[i];
      if (left >= 0 && best[left] + 1 < best[t]) { best[t] = best[left] + 1; pick[t] = i; }
    }
  }
  const build = (t: number) => {
    const out: number[] = [];
    while (t > 0) { out.push(plates[pick[t]]); t -= sizes[pick[t]]; }
    return out;
  };
  return { exact: best[goal] < Infinity ? build(goal) : null, reachable: (t: number) => t >= 0 && t <= limit && best[t] < Infinity, build, goal, Q };
}

const formatPlates = (plates: number[]) => {
  if (plates.length === 0) return 'Bar only';
  const counts = new Map<number, number>();
  plates.forEach((p) => counts.set(p, (counts.get(p) || 0) + 1));
  return [...counts.entries()].map(([p, c]) => (c > 1 ? `${c}×${p}` : `${p}`)).join(' + ');
};

const platesFor = (total: number) => {
  const fit = fitPlates((total - barWeight) / 2, activePlates());
  return fit && fit.exact;
};

function renderChips() {
  chipsEl.innerHTML = PLATE_SETS[unit]
    .map((p) => `<button type="button" class="chip ${enabled[unit].has(p) ? 'on' : ''}" data-plate="${p}">${p}</button>`)
    .join('');
}

function syncBarButtons() {
  document.querySelectorAll<HTMLButtonElement>('.bar-btn').forEach((b) => {
    const isKg = (b.textContent || '').includes('kg');
    b.hidden = isKg !== (unit === 'kg');
    b.classList.toggle('active', parseFloat(b.dataset.bar!) === barWeight);
  });
}

function renderQuick() {
  document.getElementById('quick-grid')!.innerHTML = QUICK[unit].map((w) => {
    const p = platesFor(w);
    return `<div class="quick-item" data-w="${w}"><div class="q-weight">${w} ${unit}</div><div class="q-plates">${p ? formatPlates(p) : '-'}</div></div>`;
  }).join('');
}

function calculate(userClicked: boolean) {
  const target = parseFloat(targetEl.value);
  if (!target) { if (userClicked) showError('Enter the total weight you want on the bar.'); return; }
  const results = document.getElementById('calc-results')!;
  if (target < barWeight) { showError(`The bar alone is ${barWeight} ${unit}. Enter a heavier weight.`); results.style.display = 'none'; return; }
  if (activePlates().length === 0) { showError('Turn at least one plate size on.'); results.style.display = 'none'; return; }
  showError('');

  const perSide = (target - barWeight) / 2;
  const fit = fitPlates(perSide, activePlates())!;
  const display = document.getElementById('plates-display')!;
  const breakdown = document.getElementById('weight-breakdown')!;

  if (fit && fit.exact) {
    display.textContent = formatPlates(fit.exact);
    breakdown.textContent = `${perSide} ${unit} per side · ${fit.exact.length} ${fit.exact.length === 1 ? 'plate' : 'plates'} each side · ${barWeight} ${unit} bar · ${target} ${unit} total`;
  } else {
    // Nearest weights that these plates can actually make.
    const step = 1 / fit.Q;
    let down: number | null = null, up: number | null = null;
    for (let k = 1; k <= 8 * fit.Q && (down === null || up === null); k++) {
      if (down === null && fit.reachable(fit.goal - k)) down = (fit.goal - k) * step;
      if (up === null && fit.reachable(fit.goal + k)) up = (fit.goal + k) * step;
    }
    const total = (side: number) => side * 2 + barWeight;
    display.textContent = `${target} ${unit} cannot be loaded exactly with these plates.`;
    breakdown.textContent = [down !== null ? `Nearest lighter: ${total(down)} ${unit}` : '', up !== null ? `Nearest heavier: ${total(up)} ${unit}` : ''].filter(Boolean).join(' · ');
  }

  renderQuick();
  document.getElementById('calc-results')!.style.display = 'block';
}

document.querySelectorAll<HTMLButtonElement>('.bar-btn').forEach((btn) => btn.addEventListener('click', () => {
  barWeight = parseFloat(btn.dataset.bar!); syncBarButtons(); calculate(false);
}));

document.querySelectorAll<HTMLButtonElement>('.unit-btn').forEach((btn) => btn.addEventListener('click', () => {
  document.querySelectorAll('.unit-btn').forEach((b) => b.classList.remove('active'));
  btn.classList.add('active');
  unit = btn.dataset.unit as Unit;
  barWeight = DEFAULT_BAR[unit]; // a 45 kg bar does not exist, so reset the bar with the unit
  renderChips(); syncBarButtons(); calculate(false);
}));

chipsEl.addEventListener('click', (e) => {
  const chip = (e.target as HTMLElement).closest('.chip') as HTMLElement | null;
  if (!chip) return;
  const p = parseFloat(chip.dataset.plate!);
  enabled[unit].has(p) ? enabled[unit].delete(p) : enabled[unit].add(p);
  renderChips(); calculate(false);
});

document.getElementById('quick-grid')!.addEventListener('click', (e) => {
  const item = (e.target as HTMLElement).closest('.quick-item') as HTMLElement | null;
  if (!item) return;
  targetEl.value = item.dataset.w!; calculate(true);
});

document.getElementById('calc-btn')!.addEventListener('click', () => calculate(true));
targetEl.addEventListener('keypress', (e) => { if (e.key === 'Enter') calculate(true); });
targetEl.addEventListener('input', () => calculate(false));

renderChips(); syncBarButtons(); renderQuick();
</script>
