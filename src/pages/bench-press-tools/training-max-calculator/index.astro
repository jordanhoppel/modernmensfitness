---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const schema = { "@context": "https://schema.org", "@type": "SoftwareApplication", "name": "Bench Press Training Max Calculator", "operatingSystem": "Web", "url": "https://modernmensfitness.com/bench-press-tools/training-max-calculator/", "offers": { "@type": "Offer", "price": "0" } };
---
<BaseLayout
  title="Bench Press Training Max Calculator — Find Your TM"
  description="Calculate your bench press training max for percentage-based programs. Enter your 1RM and get your training max at 85%, 90%, or 95%."
  canonical="https://modernmensfitness.com/bench-press-tools/training-max-calculator/"
  schema={schema}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a> <span>›</span>
        <a href="/bench-press-tools/">Tools</a> <span>›</span>
        <span>Training Max Calculator</span>
      </nav>
      <span class="eyebrow">Free Tool</span>
      <h1>Training Max<br/><em>Calculator.</em></h1>
      <p class="page-sub">Find the right training max percentage for your program. Most percentage-based programs use 85–90% of your 1RM as the training max.</p>
    </div>
  </section>

  <section class="section">
    <div class="container calc-layout">
      <div class="calc-main">
        <div class="calc-card">
          <div class="calc-header">
            <span class="mono" style="font-size:0.65rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--muted2);">// Enter your 1RM</span>
          </div>
          <div class="calc-inputs">
            <div class="input-group">
              <label class="input-label mono">Your 1 Rep Max</label>
              <div class="input-row">
                <input type="number" id="one-rm" placeholder="225" min="1" max="1200" class="calc-input" />
                <div class="unit-toggle">
                  <button class="unit-btn active" data-unit="lbs">lbs</button>
                  <button class="unit-btn" data-unit="kg">kg</button>
                </div>
              </div>
            </div>
            <div class="input-group">
              <label class="input-label mono">Training Max Percentage</label>
              <div class="pct-select">
                <button class="pct-btn" data-pct="85">85%</button>
                <button class="pct-btn active" data-pct="90">90%</button>
                <button class="pct-btn" data-pct="95">95%</button>
              </div>
              <p class="pct-note mono">85% = conservative start · 90% = standard · 95% = aggressive</p>
            </div>
          </div>
          <button class="calc-btn" id="calc-btn">Calculate Training Max →</button>

          <div class="calc-results" id="calc-results" style="display:none;">
            <div class="result-main">
              <span class="mono" style="font-size:0.65rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--lime);">// Your Training Max</span>
              <div class="result-tm" id="result-tm">--</div>
            </div>
            <div class="tm-table-wrap">
              <span class="mono" style="font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted2);display:block;margin-bottom:8px;">// Program percentages from your TM</span>
              <table class="tm-table" id="tm-table">
                <thead><tr><th>% of TM</th><th>Weight</th><th>Purpose</th></tr></thead>
                <tbody id="tm-body"></tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="prose" style="margin-top:48px;">
          <h2>What Is a Training Max?</h2>
          <p>A training max (TM) is a percentage of your true 1-rep max used as the base for calculating all training weights in percentage-based programs. Instead of training off 100% of your max, you train off 85–90%, which keeps the weights manageable and leaves room for technique, volume, and recovery.</p>
          <h2>Which Percentage Should I Use?</h2>
          <p><strong>85%</strong> — Best for beginners to percentage programming, lifters returning from injury, or anyone who tends to grind and fight reps. Most conservative, most sustainable.</p>
          <p><strong>90%</strong> — The standard for most intermediate programs including 5/3/1 and similar. Good balance of challenge and recoverability.</p>
          <p><strong>95%</strong> — Used by advanced lifters with excellent technique and recovery. Leaves little margin for bad days.</p>
          <h2>How the Primal Press Protocol Uses Training Max</h2>
          <p>The Primal Press Protocol calculates your training max on Day 1 and uses it to auto-generate every training weight for all 12 weeks. You enter your 1RM once — the entire program is calculated from that number automatically.</p>
        </div>
      </div>

      <aside class="calc-sidebar">
        <div class="sidebar-sticky">
          <div class="sidebar-ppp">
            <span class="eyebrow">The Program</span>
            <h4>Training Max Built In</h4>
            <p>PPP calculates your TM on Day 1 and auto-generates every working weight for 12 weeks.</p>
            <a href="https://primalpressprotocol.com?utm_source=mmf&utm_medium=tm-calc&utm_campaign=sidebar" class="btn-primary" target="_blank" rel="noopener" style="width:100%;justify-content:center;">Get PPP — $37 →</a>
          </div>
          <div class="sidebar-widget">
            <h5>More Tools</h5>
            <a href="/bench-press-tools/1rm-calculator/" class="sidebar-link"><span>1RM Calculator</span><span>→</span></a>
            <a href="/bench-press-tools/plate-loading-calculator/" class="sidebar-link"><span>Plate Calculator</span><span>→</span></a>
            <a href="/bench-press-tools/assessment-test/" class="sidebar-link"><span>Strength Assessment</span><span>→</span></a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
.page-hero { background: var(--surface); border-bottom: 1px solid var(--border); padding: 48px 0 40px; }
.breadcrumb { display: flex; gap: 8px; align-items: center; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted2); margin-bottom: 24px; flex-wrap: wrap; }
.breadcrumb a { color: var(--muted2); text-decoration: none; }
.page-hero h1 { margin: 16px 0 16px; }
.page-sub { font-size: 1rem; color: var(--muted); max-width: 500px; font-weight: 300; }
.calc-layout { display: grid; grid-template-columns: 1fr 300px; gap: 60px; align-items: start; }
.calc-card { background: var(--surface); border: 1px solid var(--border); border-top: 2px solid var(--lime); overflow: hidden; }
.calc-header { padding: 16px 24px; border-bottom: 1px solid var(--border); background: var(--lime-glow); }
.calc-inputs { padding: 28px 24px 0; display: flex; flex-direction: column; gap: 24px; }
.input-group { display: flex; flex-direction: column; gap: 10px; }
.input-label { font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted2); }
.input-row { display: flex; gap: 8px; }
.calc-input { flex: 1; background: var(--card); border: 1px solid var(--border); color: var(--text); font-family: var(--font-body); font-size: 1.1rem; font-weight: 500; padding: 12px 16px; outline: none; transition: border-color 0.2s; }
.calc-input:focus { border-color: var(--lime); }
.calc-input::placeholder { color: var(--muted2); }
.unit-toggle { display: flex; gap: 2px; }
.unit-btn { background: var(--card); border: 1px solid var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; padding: 8px 14px; cursor: pointer; transition: all 0.2s; }
.unit-btn.active { background: var(--lime); color: #0a0a0a; border-color: var(--lime); }
.pct-select { display: flex; gap: 4px; }
.pct-btn { flex: 1; background: var(--card); border: 1px solid var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.06em; padding: 12px; cursor: pointer; transition: all 0.2s; }
.pct-btn.active { background: var(--lime); color: #0a0a0a; border-color: var(--lime); font-weight: 700; }
.pct-note { font-size: 0.6rem; color: var(--muted2); letter-spacing: 0.06em; margin: 0; }
.calc-btn { display: block; width: calc(100% - 48px); margin: 24px 24px; background: var(--lime); color: #0a0a0a; font-family: var(--font-body); font-size: 1rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 16px; border: none; cursor: pointer; transition: background 0.2s; }
.calc-btn:hover { background: #ccff00; }
.calc-results { padding: 0 24px 28px; }
.result-main { background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--lime); padding: 20px 24px; margin-bottom: 20px; }
.result-tm { font-family: var(--font-display); font-size: 4rem; color: var(--lime); line-height: 1; letter-spacing: 0.02em; margin-top: 6px; }
.tm-table-wrap { margin-top: 8px; }
.tm-table th { font-size: 0.6rem; padding: 8px 12px; }
.tm-table td { font-size: 0.8rem; padding: 8px 12px; }
.sidebar-sticky { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 12px; }
.sidebar-ppp { background: var(--surface); border: 1px solid var(--border); border-top: 2px solid var(--lime); padding: 24px 20px; }
.sidebar-ppp h4 { font-family: var(--font-display); font-size: 1.4rem; letter-spacing: 0.02em; margin: 8px 0 10px; }
.sidebar-ppp p { font-size: 0.825rem; font-weight: 300; margin-bottom: 16px; }
.sidebar-widget { background: var(--surface); border: 1px solid var(--border); padding: 16px 20px; }
.sidebar-widget h5 { color: var(--muted2); margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
.sidebar-link { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 0.825rem; color: var(--muted); text-decoration: none; transition: color 0.2s; }
.sidebar-link:last-child { border-bottom: none; }
.sidebar-link:hover { color: var(--text); }
@media (max-width: 900px) { .calc-layout { grid-template-columns: 1fr; } .calc-sidebar { display: none; } }
</style>

<script>
let selectedPct = 90;
let currentUnit = 'lbs';

document.querySelectorAll('.pct-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.pct-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    selectedPct = parseInt(btn.dataset.pct);
  });
});
document.querySelectorAll('.unit-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.unit-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentUnit = btn.dataset.unit;
  });
});
document.getElementById('calc-btn').addEventListener('click', calculate);
document.getElementById('one-rm').addEventListener('keypress', e => { if(e.key === 'Enter') calculate(); });

function calculate() {
  const orm = parseFloat(document.getElementById('one-rm').value);
  if (!orm || orm <= 0) { alert('Enter your 1RM.'); return; }
  const tm = Math.round(orm * selectedPct / 100);
  document.getElementById('result-tm').textContent = `${tm} ${currentUnit}`;
  const rows = [
    [100, 'Max — test day only'],
    [95, 'Heavy strength'],
    [90, 'Strength development'],
    [85, 'Moderate strength'],
    [80, 'Volume work'],
    [75, 'Hypertrophy'],
    [70, 'Technique / speed'],
    [65, 'Warm-up / deload'],
  ];
  document.getElementById('tm-body').innerHTML = rows.map(([pct, purpose]) => {
    const w = Math.round(tm * pct / 100);
    return `<tr><td style="color:var(--lime);font-family:var(--font-mono);font-weight:600;">${pct}%</td><td style="color:var(--text);font-weight:600;">${w} ${currentUnit}</td><td>${purpose}</td></tr>`;
  }).join('');
  document.getElementById('calc-results').style.display = 'block';
}
</script>
