<style>
.site-footer { background: var(--surface); border-top: 1px solid var(--border); margin-top: 80px; }
.footer-inner { display: grid; grid-template-columns: 260px 1fr; gap: 60px; padding: 60px 0 40px; }
.footer-brand { display: flex; flex-direction: column; gap: 16px; }
.footer-logo { text-decoration: none; }
.footer-logo .logo-mmf { font-family: var(--font-display); font-size: 2.5rem; color: var(--text); letter-spacing: 0.05em; line-height: 1; }
.footer-tagline { font-size: 0.8rem; color: var(--muted2); font-weight: 300; line-height: 1.6; }
.footer-cta { align-self: flex-start; font-size: 0.8rem !important; }
.footer-cols { display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px; }
.footer-col { display: flex; flex-direction: column; gap: 5px; }
.col-label { font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text); font-weight: 700; margin-bottom: 6px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
.footer-col a { font-size: 0.75rem; color: var(--muted2); text-decoration: none; font-weight: 300; transition: color 0.2s; line-height: 1.5; }
.footer-col a:hover { color: var(--text); }
.footer-bottom { border-top: 1px solid var(--border); padding: 16px 0; }
.footer-bottom-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
.footer-legal { font-size: 0.6rem; color: var(--muted2); letter-spacing: 0.06em; margin: 0; }
.footer-disclaimer { font-size: 0.55rem; color: var(--muted2); letter-spacing: 0.04em; margin: 0; max-width: 400px; text-align: right; }
.footer-ppp-bar { background: var(--lime); padding: 12px 0; }
.ppp-bar-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
.ppp-bar-text { font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: #0a0a0a; font-weight: 600; }
.ppp-bar-btn { font-family: var(--font-body); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #0a0a0a !important; background: rgba(0,0,0,0.12); padding: 8px 20px; text-decoration: none; white-space: nowrap; transition: background 0.2s; }
.ppp-bar-btn:hover { background: rgba(0,0,0,0.2); }
@media (max-width: 1100px) { .footer-cols { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 768px) { .footer-inner { grid-template-columns: 1fr; gap: 40px; } .footer-cols { grid-template-columns: repeat(2, 1fr); } .footer-disclaimer { text-align: left; } }
@media (max-width: 480px) { .footer-cols { grid-template-columns: 1fr; } .ppp-bar-inner { flex-direction: column; gap: 10px; } }
</style>
